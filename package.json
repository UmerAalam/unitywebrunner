{
  "name": "unity-webrunner",
  "version": "1.0.0",
  "description": "Electron app for running Unity WebGL builds locally",
  "main": "dist-electron/main.js",
  "scripts": {
    "sync:icons": "node scripts/sync-lucide.cjs",
    "predev": "npm run sync:icons",
    "prebuild": "npm run sync:icons",
    "predist": "npm run sync:icons",
    "predist:linux": "npm run sync:icons",
    "predist:win": "npm run sync:icons",
    "dev": "npm run build:electron && electron .",
    "build": "npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build:electron && electron-builder --config electron-builder.config.cjs",
    "dist:linux": "npm run build:electron && electron-builder --linux --config electron-builder.config.cjs",
    "dist:win": "npm run build:electron && electron-builder --win --config electron-builder.config.cjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.12",
    "electron": "41.4.0",
    "electron-builder": "^26.8.1",
    "lucide": "^1.14.0",
    "typescript": "^5.9.3"
  }
}
